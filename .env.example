# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=urbanbet_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS - comma separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Currency
EXCHANGE_RATE_USD_TO_RWF=1200

# PawaPay (sandbox / test mode)
PAWAPAY_ENABLED=True
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# Paste the API token secret from https://dashboard.sandbox.pawapay.io/ (Developers > API tokens)
PAWAPAY_API_TOKEN=your-sandbox-api-token-here

# Cloudinary (avatar uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_AVATAR_FOLDER=urbanbet/avatars
